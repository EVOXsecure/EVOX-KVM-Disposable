Depends: python3 (>= 3.10), python3-libvirt, python3-gi, gir1.2-gtk-3.0, libvirt-daemon-system, libvirt-daemon-driver-qemu, nftables, iproute2, virt-viewer, qemu-utils, qemu-system-x86
